<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9b212e0c-90b5-4bfd-9f94-f6a48e72f62f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Content Remove="Tests/**/*" />
    <None Remove="Tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\DejaVuSans.ttf">
      <LogicalName>Fonts.DejaVuSans.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fonts\DejaVuSans-Bold.ttf">
      <LogicalName>Fonts.DejaVuSans-Bold.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fonts\DejaVuSans-Italic.ttf">
      <LogicalName>Fonts.DejaVuSans-Italic.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fonts\DejaVuSans-BoldItalic.ttf">
      <LogicalName>Fonts.DejaVuSans-BoldItalic.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\logo-hope.png">
      <LogicalName>Assets.logo-hope.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- PDFsharp traz o Pkcs 8.0.1 (vulnerável); fixamos a versão corrigida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
